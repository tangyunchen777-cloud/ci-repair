# Local-only demonstration values; copy to .env. Never commit real credentials.
POSTGRES_USER=ci_repair
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=ci_repair
DATABASE_URL=postgresql+asyncpg://ci_repair:local-development-only@postgres:5432/ci_repair
DATABASE_SSL=false
# For RDS set true and mount the AWS RDS CA bundle, then set DATABASE_SSL_CA.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_NAME=ci-repair-events
SQS_DLQ_NAME=ci-repair-events-dlq
SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/ci-repair-events
S3_BUCKET=ci-repair-local-artifacts
# Passed only to worker; Actions:read on the selected source repositories.
GITHUB_TOKEN=
